"""
Bladder-temperature data cleaning pipeline, instrumented so that every
exclusion step records its counts, and a CONSORT-style flow diagram is
generated directly from those counts.

The figure can therefore never disagree with the code: change a threshold
and the diagram updates on the next run.

Outputs
-------
    blaas_2h_filled.csv        cleaned analysis dataset
    data_cleaning_flow.png     flow diagram (raster)
    data_cleaning_flow.svg     flow diagram (vector, for LaTeX)
    data_cleaning_counts.csv   the counts behind the diagram
"""

from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")                       # no GUI needed
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch, Circle, FancyArrowPatch

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
IN_CSV   = Path(r"C:\Users\G10073190\Documents\temp_2026-02-03_10-04-47.csv")
OUT_DIR  = IN_CSV.parent

LOCATION  = "Blaas"   # temperature site to analyse
MAX_GAP_H = 4         # keep encounters whose largest gap is <= this (hours)
MIN_OBS   = 50        # minimum series length for robust ARIMA, applied AFTER
                      # interpolation and counting real + interpolated points

# NOTE: encounterId is the patient/series unit in this dataset -- one
# encounterId corresponds to one patient time series.
PATIENT_COL = "encounterId"

# ----------------------------------------------------------------------
# Counting helpers
# ----------------------------------------------------------------------
STAGES = []          # cohort boxes, in order
STEPS  = []          # exclusion / addition boxes, in order


def tally(frame):
    """Counts describing one cohort snapshot (encounterId = patient)."""
    return {
        "patients": int(frame["encounterId"].nunique()) if len(frame) else 0,
        "observations": int(len(frame)),
    }


def add_stage(frame, title=None):
    counts = tally(frame)
    STAGES.append({"title": title, **counts})
    return counts


def add_step(before, after, reason, added=False):
    """Record an exclusion (or addition) as the difference between two tallies."""
    delta = {k: before[k] - after[k] for k in before}
    if added:
        delta = {k: -v for k, v in delta.items()}
    STEPS.append({"reason": reason, "added": added, **delta})


# ----------------------------------------------------------------------
# 1. Load
# ----------------------------------------------------------------------
df = pd.read_csv(IN_CSV)

# Carry the recorded site forward within each encounter
df["Temperatuurlocaties"] = (
    df.groupby("encounterId")["Temperatuurlocaties"].ffill()
)

c_raw = add_stage(df, "All temperature records")

# ----------------------------------------------------------------------
# 2. Restrict to the chosen measurement site
# ----------------------------------------------------------------------
blaas_df = df[df["Temperatuurlocaties"] == LOCATION].copy()

c_site = add_stage(blaas_df, f"{LOCATION} records")
add_step(c_raw, c_site, "Other measurement site or site not recorded")

# ----------------------------------------------------------------------
# 3. Parse values and timestamps; drop unusable rows
# ----------------------------------------------------------------------
blaas_df["Temp."] = pd.to_numeric(
    blaas_df["Temp."].astype(str).str.replace(",", ".", regex=False),
    errors="coerce",
)
blaas_df["timestamp"] = pd.to_datetime(blaas_df["chartTime"], errors="coerce")

valid = (
    blaas_df.dropna(subset=["timestamp", "Temp."])
            .sort_values(["encounterId", "timestamp"])
            .copy()
)

c_valid = add_stage(valid, "Valid readings")
add_step(c_site, c_valid, "Missing or non-numeric temperature / timestamp")

# ----------------------------------------------------------------------
# 4. Snap to the 2-hour grid
#    Stage 1: round to the nearest whole hour
#    Stage 2: keep only even hours
# ----------------------------------------------------------------------
valid["hour_ts"] = valid["timestamp"].dt.round("1h")

even = valid[valid["hour_ts"].dt.hour % 2 == 0].copy()

c_even = add_stage(even, "On 2-hour grid")
add_step(c_valid, c_even, "Reading rounded to an odd hour")

# ----------------------------------------------------------------------
# 5. Resolve collisions: if two readings land on the same grid point,
#    keep the one recorded closest to it (no averaging)
# ----------------------------------------------------------------------
even["_dist"] = (even["timestamp"] - even["hour_ts"]).abs()

resampled = (
    even.sort_values(["encounterId", "hour_ts", "_dist"])
        .drop_duplicates(["encounterId", "hour_ts"], keep="first")
        .rename(columns={"timestamp": "chartTime", "hour_ts": "timestamp"})
        .reset_index(drop=True)
)
resampled = resampled[["encounterId", "timestamp", "chartTime", "Temp."]]

c_resampled = add_stage(resampled, "Resampled series")
add_step(c_even, c_resampled, "Duplicate reading on the same grid point")

# ----------------------------------------------------------------------
# 6. Continuity screen, evaluated on the REAL observations.
#    A gap of more than MAX_GAP_H hours means more than one consecutive
#    missing grid point, which cannot be bridged by interpolation.
# ----------------------------------------------------------------------
max_gap = (
    resampled.sort_values(["encounterId", "timestamp"])
             .groupby("encounterId")["timestamp"]
             .apply(lambda t: t.diff().dt.total_seconds().div(3600).max())
             .fillna(0.0)               # a single-observation series has no gap
)
continuous_ids = max_gap.index[max_gap <= MAX_GAP_H]
continuous = (
    resampled[resampled["encounterId"].isin(continuous_ids)]
    .reset_index(drop=True)
)

c_cont = add_stage(continuous, "Continuous series")
add_step(c_resampled, c_cont,
         f"Gap > {MAX_GAP_H} h (more than one consecutive missing grid point)")

# ----------------------------------------------------------------------
# 7. Interpolate the single-slot holes on the regular grid.
#    Done BEFORE the length screen, so interpolated points count towards it.
# ----------------------------------------------------------------------
def fill_one(g):
    s_ = g.set_index("timestamp")["Temp."].sort_index()
    full = pd.date_range(s_.index.min(), s_.index.max(), freq="2h")
    out = s_.reindex(full).to_frame("Temp.")
    out.index.name = "timestamp"

    was_missing = out["Temp."].isna()
    out["Temp."] = (out["Temp."]
                    .interpolate(method="linear", limit_area="inside")
                    .round(1))

    out["is_interpolated"] = was_missing & out["Temp."].notna()
    out["encounterId"] = g["encounterId"].iloc[0]
    out["chartTime"] = out.index
    return out.reset_index()


parts = [fill_one(g) for _, g in continuous.groupby("encounterId", sort=True)]
if not parts:
    raise SystemExit(
        f"No encounters survived the continuity screen (gap <= {MAX_GAP_H} h). "
        "Check the input data or relax MAX_GAP_H."
    )
filled = pd.concat(parts, ignore_index=True)
filled = filled.dropna(subset=["Temp."]).reset_index(drop=True)
filled = filled[["encounterId", "timestamp", "chartTime", "Temp.", "is_interpolated"]]

n_interp = int(filled["is_interpolated"].sum())

c_filled = add_stage(filled, None)
add_step(c_cont, c_filled,
         f"Interpolated single missing grid points ({n_interp})", added=True)

# ----------------------------------------------------------------------
# 8. Length screen: robust ARIMA needs at least MIN_OBS observations.
#    Real and interpolated points both count towards the total.
# ----------------------------------------------------------------------
obs_per_enc = filled.groupby("encounterId").size()
keep_ids    = obs_per_enc[obs_per_enc >= MIN_OBS].index
blaas_2h_filled = (
    filled[filled["encounterId"].isin(keep_ids)].reset_index(drop=True)
)

c_final = add_stage(blaas_2h_filled, "Final analysis cohort")
add_step(c_filled, c_final,
         [f"Fewer than {MIN_OBS} observations, the minimum",
          "series length for robust ARIMA"])

# ----------------------------------------------------------------------
# 9. Write the dataset and the counts
# ----------------------------------------------------------------------
blaas_2h_filled.to_csv(
    OUT_DIR / "blaas_2h_filled.csv",
    index=False,
    date_format="%Y-%m-%d %H:%M:%S",
    float_format="%.1f",
)
print(f"wrote {len(blaas_2h_filled)} rows to blaas_2h_filled.csv")

pd.DataFrame(STAGES).to_csv(OUT_DIR / "data_cleaning_counts.csv", index=False)
print("\n=== Cohort at each stage ===")
print(pd.DataFrame(STAGES).to_string(index=False))
print("\n=== Excluded / added at each step ===")
print(pd.DataFrame(STEPS).to_string(index=False))


# ======================================================================
# Flow diagram, drawn from STAGES / STEPS
# ======================================================================
C_FILL, C_EDGE, C_TXT = "#cdddf0", "#5b8ac6", "#1f4e79"
BOX_EDGE, FINAL_FILL = "#222222", "#eef4fb"

# which count columns to show, and how to colour them
COLUMNS = [
    ("patients", "Patients", "#1f4e79"),
    ("observations", "Observations", "#7a4b12"),
]


def fmt(n, plus=False):
    return f"{'+' if plus and n > 0 else ''}{n:,}"


def make_flowchart(stages, steps, out_stem):
    n_steps = len(steps)
    row_h   = 3.1
    top_y   = 2.0 + n_steps * row_h + 1.2

    fig_h = 2.4 + n_steps * 2.0
    fig_w = 5.4 + 2.2 * len(COLUMNS) + 6.6

    fig, ax = plt.subplots(figsize=(fig_w, fig_h))
    ax.axis("off")

    # geometry
    main_col_w = 2.35
    MW = main_col_w * len(COLUMNS) + 1.5
    MC_X = 0.4 + MW / 2
    MH = 1.15
    EX_L = MC_X + MW / 2 + 2.6
    col_w = 2.0
    reason_off = 0.7 + col_w * len(COLUMNS) + 0.5
    EX_W = reason_off + 7.1
    EX_H = 1.35

    ax.set_xlim(0, EX_L + EX_W + 0.4)
    ax.set_ylim(1.2, top_y + 1.3)

    # x offsets of each count column, centred inside the main box
    span = main_col_w * (len(COLUMNS) - 1)
    offs = [-span / 2 + i * main_col_w for i in range(len(COLUMNS))]

    # ---- column headers ----
    for off, (_, label, colour) in zip(offs, COLUMNS):
        ax.text(MC_X + off, top_y + 0.75, label, ha="center", va="center",
                fontsize=11, fontweight="bold", color=colour)
    for i, (_, label, colour) in enumerate(COLUMNS):
        ax.text(EX_L + 0.7 + col_w * i + col_w / 2, top_y + 0.75, label,
                ha="center", va="center", fontsize=10,
                fontweight="bold", color=colour)
    ax.text(EX_L + reason_off, top_y + 0.75, "Step", ha="left", va="center",
            fontsize=10, fontweight="bold", color="#333333")

    # ---- cohort boxes ----
    y_stage = [top_y - i * row_h for i in range(len(stages))]

    for y, st in zip(y_stage, stages):
        highlight = st is stages[-1]
        ax.add_patch(FancyBboxPatch(
            (MC_X - MW / 2, y - MH / 2), MW, MH,
            boxstyle="round,pad=0.02,rounding_size=0.18",
            linewidth=1.9 if highlight else 1.3,
            edgecolor=BOX_EDGE,
            facecolor=FINAL_FILL if highlight else "white", zorder=3))

        dy = 0.0
        if st["title"]:
            ax.text(MC_X, y + 0.30, st["title"], ha="center", va="center",
                    fontsize=10, fontweight="bold", zorder=4)
            dy = -0.20
        for off, (key, _, colour) in zip(offs, COLUMNS):
            ax.text(MC_X + off, y + dy, fmt(st[key]), ha="center", va="center",
                    fontsize=11, color=colour, zorder=4)

    # ---- arrows and exclusion boxes ----
    for i, stp in enumerate(steps):
        y_top, y_bot = y_stage[i], y_stage[i + 1]
        y_mid = (y_top + y_bot) / 2

        ax.add_patch(FancyArrowPatch((MC_X, y_top - MH / 2), (MC_X, y_bot + MH / 2),
                     arrowstyle="-|>", mutation_scale=16, linewidth=1.7,
                     color=BOX_EDGE, zorder=2))
        ax.add_patch(FancyArrowPatch((MC_X, y_mid), (EX_L, y_mid),
                     arrowstyle="-|>", mutation_scale=14, linewidth=1.5,
                     color=BOX_EDGE, zorder=2))

        ax.add_patch(FancyBboxPatch(
            (EX_L, y_mid - EX_H / 2), EX_W, EX_H,
            boxstyle="round,pad=0.02,rounding_size=0.22",
            linewidth=1.2, edgecolor=BOX_EDGE, facecolor="white", zorder=3))
        ax.add_patch(Circle((EX_L + 0.05, y_mid), 0.36, facecolor=C_FILL,
                     edgecolor=C_EDGE, linewidth=1.3, zorder=5))
        ax.text(EX_L + 0.05, y_mid, str(i + 1), ha="center", va="center",
                fontsize=10.5, fontweight="bold", color=C_TXT, zorder=6)

        for j, (key, _, colour) in enumerate(COLUMNS):
            ax.text(EX_L + 0.7 + col_w * j + col_w / 2, y_mid,
                    fmt(stp[key], plus=stp["added"]),
                    ha="center", va="center", fontsize=10.5,
                    color=colour, zorder=4)

        rl = stp["reason"] if isinstance(stp["reason"], list) else [stp["reason"]]
        for k, r in enumerate(rl):
            yy = y_mid + (len(rl) - 1) * 0.17 - k * 0.34
            ax.text(EX_L + reason_off, yy, r, ha="left", va="center",
                    fontsize=9.8, zorder=4)

    fig.savefig(f"{out_stem}.png", dpi=200, bbox_inches="tight")
    fig.savefig(f"{out_stem}.svg", bbox_inches="tight")
    plt.close(fig)


make_flowchart(STAGES, STEPS, str(OUT_DIR / "data_cleaning_flow"))
print("\nwrote data_cleaning_flow.png / .svg")




