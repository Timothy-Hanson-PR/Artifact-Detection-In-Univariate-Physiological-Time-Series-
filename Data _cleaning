# Select series from blaas_2h with (a) >=50 real observations and
# (b) no gap larger than one missing observation (max_gap <= 4h),
# then interpolate the single-slot gaps.
# =============================================================================

# --- Per-encounter qualification (on real observations, before any filling) ---
qual = (
    blaas_2h
    .sort_values(["encounterId", "timestamp"])
    .groupby("encounterId")
    .agg(
        n_obs=("timestamp", "size"),
        max_gap_h=("timestamp", lambda t: t.diff().dt.total_seconds().div(3600).max()),
    )
)

eligible = qual.index[(qual["n_obs"] >= 50) & (qual["max_gap_h"] <= 4)]
selected = blaas_2h[blaas_2h["encounterId"].isin(eligible)].copy()

# --- Per-encounter: lay down the regular 2h grid and interpolate the holes ---
interpolated_records = []

def fill_one(g):
    enc_id = g["encounterId"].iloc[0]
    s = g.set_index("timestamp")["Temp."].sort_index()

    # Regular 2h grid from first to last real reading
    full = pd.date_range(s.index.min(), s.index.max(), freq="2h")
    out = s.reindex(full).to_frame("Temp.")
    out.index.name = "timestamp"

    was_missing = out["Temp."].isna()

    # Linear interpolation, interior only. Since max_gap <= 4h, every gap is a
    # single empty slot, so there are no long gaps to revert.
    out["Temp."] = out["Temp."].interpolate(method="linear", limit_area="inside").round(1)

    out["is_interpolated"] = was_missing & out["Temp."].notna()
    out["encounterId"]     = enc_id
    out["chartTime"]       = out.index          # synthetic rows: chartTime = grid time

    # Collect filled points
    filled = out[out["is_interpolated"]].reset_index()
    if not filled.empty:
        interpolated_records.append(filled[["encounterId", "timestamp", "Temp."]])

    return out.reset_index()

blaas_2h_filled = (
    selected
    .groupby("encounterId", group_keys=False)
    .apply(fill_one)
    .reset_index(drop=True)
)[["encounterId", "timestamp", "chartTime", "Temp.", "is_interpolated"]]





