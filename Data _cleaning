# =============================================================================
# Two-stage resample of blaas_df:
#   Stage 1: round each reading to the nearest WHOLE hour (09:25->09:00, 09:55->10:00)
#   Stage 2: drop odd-hour readings; even-hour survivors are already the 2h grid
# =============================================================================
_b = blaas_df.copy()
_b["timestamp"] = pd.to_datetime(_b["chartTime"], errors="coerce")
_b = _b.drop(columns=["chartTime"])                       # avoid duplicate column later
_b = _b.dropna(subset=["timestamp", "Temp."]).sort_values(["encounterId", "timestamp"])

n_raw = len(_b)

# --- Stage 1: round to nearest whole hour ---
_b["hour_ts"] = _b["timestamp"].dt.round("1h")

# --- Stage 2: keep only EVEN-hour readings (the 2h grid) ---
is_even = _b["hour_ts"].dt.hour % 2 == 0
n_dropped_odd = int((~is_even).sum())
_b = _b[is_even]

# Distance from the rounded hour to its own value, for closest-wins on collisions
_b["_dist"] = (_b["timestamp"] - _b["hour_ts"]).abs()

# If two readings round to the same even hour, keep the one closest to it (no averaging)
resampled = (
    _b.sort_values(["encounterId", "hour_ts", "_dist"])
      .drop_duplicates(["encounterId", "hour_ts"], keep="first")
      .rename(columns={"timestamp": "chartTime", "hour_ts": "timestamp"})
      [["encounterId", "timestamp", "chartTime", "Temp."]]
      .reset_index(drop=True)
)

n_after_collision = len(resampled)

# --- Keep only series with more than 30 observations ---
